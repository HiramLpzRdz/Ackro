{
  "pkg": "@ackro/ui",
  "globalName": "AckroUI",
  "shape": "package",
  "buildCmd": "npm run build",
  "cssEntry": "dist/ackro.css",
  "extraFonts": [
    "node_modules/@fontsource/dm-sans/latin-400.css",
    "node_modules/@fontsource/dm-sans/latin-600.css",
    "node_modules/@fontsource/dm-sans/latin-700.css",
    "node_modules/@fontsource/space-grotesk/latin-700.css",
    "node_modules/@fontsource/playfair-display/latin-700.css"
  ],
  "overrides": {
    "NavBar": {
      "cardMode": "column",
      "viewport": "1320x380"
    },
    "Footer": {
      "cardMode": "column",
      "viewport": "1240x440"
    },
    "ServiceCard": {
      "cardMode": "column"
    },
    "FAQList": {
      "cardMode": "column"
    },
    "Button": {
      "cardMode": "column"
    },
    "SectionHeading": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}